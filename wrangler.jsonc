{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crucix-cloudflare",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dashboard/public",
    "binding": "ASSETS"
  },
  // Cloudflare Dashboard 部署时，请在 Worker 的 Settings > Bindings 中绑定 KV。
  // 变量名必须是 CRUCIX_KV；命令行用户也可以运行 `npm run cf:setup` 自动写入 kv_namespaces。
  "vars": {
    "LANGUAGE": "zh-CN",
    "REFRESH_INTERVAL_MINUTES": "15",
    "PUBLIC_APP_NAME": "Crucix 中文版",
    "PUBLIC_POLLING_INTERVAL_SECONDS": "15",
    "ENABLE_LLM": "false",
    "ENABLE_TELEGRAM": "false",
    "ENABLE_DISCORD": "false",
    "ENABLE_TELEGRAM_SOURCE": "true",
    "ENABLE_REDDIT_SOURCE": "false"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
